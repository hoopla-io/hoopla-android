<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:gravity="start"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/grey_400"
            android:textSize="12sp"
            tools:text="Milk" />

        <!-- Whether the group must be answered. The finer min/max rule, when there is one, is
             stated on its own line below. -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_corner8_grey200"
            android:fontFamily="@font/inter_medium"
            android:gravity="end"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/grey_350"
            android:textSize="11sp"
            tools:text="Optional" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- Only for rules the Required/Optional badge cannot express, i.e. "at least 2" / "up to 3". -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/rule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/grey_400"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Up to 3"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/options_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="3"
        tools:listitem="@layout/item_drink_modification" />

</androidx.appcompat.widget.LinearLayoutCompat>