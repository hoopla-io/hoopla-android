<?xml version="1.0" encoding="utf-8"?>
<!--
    One cart line, as its own white card: the drink's picture, then a column with the name, the
    modifiers it was added with and the price beside a quantity stepper.
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_corner20_white"
    android:orientation="horizontal"
    android:padding="20dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image"
        android:layout_width="49dp"
        android:layout_height="61dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_coffee_cup"
        tools:ignore="ImageContrastCheck" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:maxLines="2"
            android:textColor="@color/black_300"
            android:textSize="20sp"
            tools:text="Iced Mango Latte" />

        <!--
            Filled in by the adapter: one row per modifier, then the per-unit price when the line
            holds more than one. Both counts vary per line, so none of it can be declared here.
        -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
                Shrinks a step or two rather than clipping. A six-figure total does not fit
                beside the stepper at 18sp on a 360dp screen, and a truncated price is worse
                than a slightly smaller one.
            -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lineTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="@color/black_300"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeMinTextSize="14sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                tools:text="40 000 UZS" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/stepper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_corner20_grey300"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- Doubles as delete: at one, stepping down drops the line. -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/minus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="@string/cart_decrease_quantity"
                    android:foreground="@drawable/ripple_round"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/black_300" />

                <!--
                    The design spaces this 16dp off each button. Android's narrowest common
                    width is 15dp tighter than the frame it was drawn on, and those 12dp go to
                    the price beside it, which has nowhere else to get them.
                -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:minWidth="10dp"
                    android:textColor="@color/black_300"
                    android:textSize="16sp"
                    tools:text="1" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/plus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="@string/cart_increase_quantity"
                    android:foreground="@drawable/ripple_round"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/black_300" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
