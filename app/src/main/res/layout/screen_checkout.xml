<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_50"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_view"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/status_bar_view"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_left_back"
        app:title="@string/order_details"
        app:titleTextAppearance="@style/ToolbarTitleTextStyle"
        app:titleTextColor="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-40dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/balance_container"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="16dp"
                android:background="@color/grey_500"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.5"
                app:shapeAppearanceOverlay="@style/ImageAppearanceCorner20" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black_400"
                android:textSize="24sp"
                app:layout_constraintBottom_toTopOf="@id/cafe_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/image"
                app:layout_constraintTop_toTopOf="@id/image"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="Cappuccino" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/cafe_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="16dp"
                android:text="@string/label_by_shop"
                android:textColor="@color/black_400"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="@id/image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/image"
                app:layout_constraintTop_toBottomOf="@id/name" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/image"
                app:layout_constraintVertical_bias="0">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:paddingVertical="7.5dp">

                    <TextView
                        android:id="@+id/name2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="@color/grey_350"
                        android:textSize="16sp"
                        tools:text="Cappuccino" />

                    <TextView
                        android:id="@+id/drink_summa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/grey_350"
                        android:textSize="16sp"
                        tools:text="+32 000 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/info_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_summa_info" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/promo_discount_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7.5dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/promo_discount_"
                        android:textColor="@color/grey_350"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/promo_discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/green_300"
                        android:textSize="16sp"
                        tools:text="-10 000 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/used_cashback_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="7.5dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/cashback_"
                        android:textColor="@color/grey_350"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/used_cashback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/grey_350"
                        android:textSize="16sp"
                        tools:text="-2 000 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7.5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/total_"
                        android:textColor="@color/black_300"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/total_summa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/black_300"
                        android:textSize="20sp"
                        tools:text="44 000 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/earn_cashback_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7.5dp"
                    android:orientation="horizontal"
                    android:paddingVertical="7.5dp">

                    <TextView
                        android:id="@+id/earn_cashback_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/green_200"
                        android:textSize="14sp"
                        tools:text="You'll earn (5%)" />

                    <TextView
                        android:id="@+id/earn_cashback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/green_200"
                        android:textSize="14sp"
                        tools:text="+2 200 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/balance_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_dialog_fragment"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ============================ Promocode ============================ -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_corner16_grey300"
            android:minHeight="56dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <!-- Empty state: a button that opens the promocode input dialog -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/promo_add_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/ripple_corner14"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/primary" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/promo_add"
                    android:textColor="@color/black_300"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_right_black300"
                    app:tint="@color/grey_350" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Applied state: tap to change the code, or × to remove it -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/promo_applied_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/ripple_corner14"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_done"
                    app:tint="@color/green_300" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/promo_applied_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/black_400"
                        android:textSize="15sp"
                        tools:text="SUMMER25" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/promo_applied_discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/green_300"
                        android:textSize="13sp"
                        tools:text="-10 000 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/remove_promo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/ripple_corner14"
                    android:contentDescription="@string/promo_remove"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/grey_350" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- ============================ Cashback ============================= -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_corner16_grey300"
            android:orientation="vertical"
            android:padding="14dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_money_cashback" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/cashback_title"
                        android:textColor="@color/black_300"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/cashback_available"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="@color/grey_350"
                        android:textSize="13sp"
                        tools:text="Available: 10 000 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/use_cashback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/switch_thumb"
                    app:showText="false"
                    app:splitTrack="false"
                    app:thumbTint="@color/white"
                    app:track="@drawable/switch_track"
                    app:trackTint="@color/selector_switch_track"
                    app:useMaterialThemeColors="false" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Visible only when some cashback is being applied -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/cashback_amount_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/grey_250" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/cashback_using"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="@color/black_300"
                        android:textSize="14sp"
                        tools:text="Used: 2 000 UZS" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/cashback_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_corner14"
                        android:fontFamily="@font/inter_medium"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/change"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- ===================== Pickup time + Order ========================= -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="50dp">

            <!-- An optional tweak, not a step in the flow: it rides alongside the primary
                 action as a compact secondary control instead of taking a card of its own.
                 Defaults to ASAP, which is what every order did before this existed. -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/pickup_row"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/bg_corner28_grey300"
                android:clickable="true"
                android:contentDescription="@string/pickup_time_title"
                android:focusable="true"
                android:foreground="@drawable/ripple_corner28"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/grey_350" />

                <!-- Turns primary-coloured once a time is chosen, so a non-default choice
                     reads at a glance without shouting when it is the default. -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/pickup_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:maxWidth="110dp"
                    android:maxLines="1"
                    android:text="@string/pickup_asap_short"
                    android:textColor="@color/grey_400"
                    android:textSize="13sp"
                    tools:text="Завтра, 09:15" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- The wrapper carries the weight, not the button: the loading morph animates
                 the button's layoutParams.width, which a weighted child would have its width
                 recomputed away from on every measure pass. -->

            <com.github.leandroborgesferreira.loadingbutton.customViews.CircularProgressButton
                android:id="@+id/order"
                style="@style/PrimaryColorButtonStyle"
                android:layout_gravity="center"
                android:layout_marginStart="8dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_corner28_primary300"
                android:text="@string/order"
                android:textAllCaps="false"
                app:finalCornerAngle="28dp"
                app:initialCornerAngle="28dp"
                app:spinning_bar_color="@color/white"
                app:spinning_bar_padding="6dp"
                app:spinning_bar_width="4dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>