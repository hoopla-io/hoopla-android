<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/eugusto_bold_700"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="@string/app_name_lowercase"
            android:textColor="@color/white"
            android:textSize="28sp" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.gms.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:mapType="normal"
        app:uiCompass="true"
        app:uiZoomControls="false" />

    <!-- Info card shown when a café marker is tapped. Hidden until then. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/shop_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/grey_200"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/card_image"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@color/grey_200"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ItemShopImageAppearance"
                tools:src="@color/grey_200" />

            <ImageView
                android:id="@+id/card_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/ripple_round"
                android:contentDescription="@string/close"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/grey_400" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/card_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="2"
                android:textColor="@color/black_400"
                android:textSize="17sp"
                app:layout_constraintEnd_toStartOf="@id/card_close"
                app:layout_constraintStart_toEndOf="@id/card_image"
                app:layout_constraintTop_toTopOf="@id/card_image"
                tools:text="Safia Coffee" />

            <!-- Rating and distance share one row so a hidden rating can't displace the distance. -->
            <LinearLayout
                android:id="@+id/card_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/card_name"
                app:layout_constraintTop_toBottomOf="@id/card_name">

                <LinearLayout
                    android:id="@+id/card_rating_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/star_rating" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/card_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:singleLine="true"
                        android:textColor="@color/black_400"
                        android:textSize="14sp"
                        tools:text="4.7" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_distance_group"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location"
                        app:tint="@color/grey_400" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/card_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_regular"
                        android:singleLine="true"
                        android:textColor="@color/grey_400"
                        android:textSize="14sp"
                        tools:text="1.2 км" />

                </LinearLayout>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/card_paused_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_paused_badge"
                android:fontFamily="@font/inter_medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/not_accepting_orders"
                android:textColor="@color/error_400"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/card_name"
                app:layout_constraintTop_toBottomOf="@id/card_meta"
                tools:visibility="visible" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/card_row_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="card_image,card_meta,card_paused_badge" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/card_order"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_corner14_primary300"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:text="@string/order"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_row_barrier" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>