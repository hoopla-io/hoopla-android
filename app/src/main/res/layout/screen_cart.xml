<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_150">

    <!-- A tab, so no back arrow, and MainActivity already draws the status bar above this. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:title="@string/cart_title"
        app:titleTextAppearance="@style/ToolbarTitleTextStyle"
        app:titleTextColor="@color/white" />

    <!--
        Everything below stays hidden until a cart has actually rendered: a failed load must
        not leave a checkout button armed over blank totals.
    -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/checkout"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/shop_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/black_300"
                android:textSize="18sp"
                android:visibility="gone"
                tools:text="Hoopla Central"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/grey_400"
                android:textSize="14sp"
                tools:text="3 items" />

            <!-- Every line is its own card; the gap between them comes from the row itself. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cart_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_cart" />

            <!-- ============================ Promocode ============================ -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/promo_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_corner16_grey300"
                android:minHeight="56dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <!-- Empty state: a button that opens the promocode input dialog -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/promo_add_row"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/ripple_corner14"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/primary" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/promo_add"
                        android:textColor="@color/black_300"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_right_black300"
                        app:tint="@color/grey_350" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Applied state: tap to change the code, or × to remove it -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/promo_applied_row"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/ripple_corner14"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_done"
                        app:tint="@color/green_300" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/promo_applied_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black_400"
                            android:textSize="15sp"
                            tools:text="SUMMER25" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/promo_applied_discount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/green_300"
                            android:textSize="13sp"
                            tools:text="-10 000 UZS" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/remove_promo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/ripple_corner14"
                        android:contentDescription="@string/promo_remove"
                        android:padding="6dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/grey_350" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- ============================= Comment ============================= -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/comment_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_medium"
                android:text="@string/cart_comment_title"
                android:textColor="@color/black_300"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/comment_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/inter_regular"
                android:gravity="top"
                android:hint="@string/order_comment_hint"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"
                android:minLines="2"
                android:padding="16dp"
                android:textSize="15sp" />

            <!-- ============================ Cashback ============================= -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/cashback_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_corner16_grey300"
                android:orientation="vertical"
                android:padding="14dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_money_cashback" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/cashback_title"
                            android:textColor="@color/black_300"
                            android:textSize="15sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/cashback_available"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/grey_350"
                            android:textSize="13sp"
                            tools:text="Available: 10 000 UZS" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/use_cashback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb"
                        app:showText="false"
                        app:splitTrack="false"
                        app:thumbTint="@color/white"
                        app:track="@drawable/switch_track"
                        app:trackTint="@color/selector_switch_track"
                        app:useMaterialThemeColors="false" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Visible only when some cashback is being applied -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/cashback_amount_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/grey_250" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/cashback_using"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/black_300"
                            android:textSize="14sp"
                            tools:text="Used: 2 000 UZS" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/cashback_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ripple_corner14"
                            android:fontFamily="@font/inter_medium"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="@string/change"
                            android:textColor="@color/primary"
                            android:textSize="14sp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- ============================= Summary ============================= -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/summary_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_corner16_grey300"
                android:orientation="vertical"
                android:padding="14dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/cart_subtotal_"
                        android:textColor="@color/grey_400"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/subtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/black_300"
                        android:textSize="14sp"
                        tools:text="55 000 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/promo_discount_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/promo_discount_"
                        android:textColor="@color/grey_400"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/promo_discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/green_300"
                        android:textSize="14sp"
                        tools:text="-10 000 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/grey_250" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/total_"
                        android:textColor="@color/black_300"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/total_summa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/black_400"
                        android:textSize="16sp"
                        tools:text="55 000 UZS" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ============================ Empty state ============================ -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:alpha="0.35"
            android:contentDescription="@null"
            android:src="@drawable/ic_coffee_cup" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_medium"
            android:text="@string/cart_empty_title"
            android:textColor="@color/black_300"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="@string/cart_empty_message"
            android:textColor="@color/grey_400"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/browse_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_corner14_width_primary300"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/cart_browse_menu"
            android:textColor="@color/primary"
            android:textSize="15sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- ============================ Load failure =========================== -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/error_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:textColor="@color/grey_400"
            android:textSize="14sp"
            tools:text="Could not load the cart" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_corner14_width_primary300"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/cart_retry"
            android:textColor="@color/primary"
            android:textSize="15sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.github.leandroborgesferreira.loadingbutton.customViews.CircularProgressButton
        android:id="@+id/checkout"
        style="@style/PrimaryColorButtonStyle"
        android:layout_width="match_parent"
        android:background="@drawable/bg_corner28_primary300"
        android:text="@string/cart_checkout"
        android:textAllCaps="false"
        android:visibility="gone"
        tools:visibility="visible"
        app:finalCornerAngle="26dp"
        app:initialCornerAngle="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:spinning_bar_color="@color/white"
        app:spinning_bar_padding="6dp"
        app:spinning_bar_width="4dp" />

    <!--
        Shown only for the very first load, when there is nothing on screen yet. Every later
        refresh rides the SwipeRefreshLayout spinner so the cart never blanks out under the
        customer.
    -->
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
