        <uz.alphazet.domain.ui.views.PillSizeSelectorView
            android:id="@+id/size_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/order"
            app:layout_constraintEnd_toStartOf="@id/order"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/order"
            app:pillSelectedTextColor="@color/primary_300" />

        <com.github.leandroborgesferreira.loadingbutton.customViews.CircularProgressButton
            android:id="@+id/order"
            style="@style/PrimaryColorButtonStyle"
            android:layout_width="0dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_corner28_primary300"
            android:text="24 000 UZS"
            android:textAllCaps="false"
            app:finalCornerAngle="10dp"
            app:initialCornerAngle="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.4"
            app:spinning_bar_color="@color/white"
            app:spinning_bar_padding="6dp"
            app:spinning_bar_width="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>