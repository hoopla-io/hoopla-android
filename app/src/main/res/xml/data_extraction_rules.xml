<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / transfer rules for API 31+ (android:dataExtractionRules). -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Encrypted prefs store (tokens + cached prefs): never send to the cloud. -->
        <exclude domain="sharedpref" path="app_cache_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Keystore key is non-exportable, so transferred ciphertext is useless. -->
        <exclude domain="sharedpref" path="app_cache_secure.xml" />
    </device-transfer>
</data-extraction-rules>
