<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for API < 31 (android:fullBackupContent). -->
<full-backup-content>
    <!--
      Exclude the encrypted prefs store (tokens + all cached prefs live here).
      Its AES key lives in the device-bound Android Keystore and never leaves
      the device, so a backed-up copy would be undecryptable anyway; excluding
      it avoids shipping ciphertext off-device.
    -->
    <exclude domain="sharedpref" path="app_cache_secure.xml" />
</full-backup-content>
