<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Layer 1: Options Container (Unselected Labels) -->
    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_pill_container"
        android:orientation="horizontal"
        android:weightSum="1">
        <!-- Views added dynamically in code -->
    </LinearLayout>

    <!-- Layer 2: Sliding Indicator -->
    <androidx.cardview.widget.CardView
        android:id="@+id/indicatorCard"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_vertical"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="36dp"
        app:cardElevation="4dp"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textSelectedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M"
                android:textColor="#D79965"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSelectedVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="300ml"
                android:textColor="#808080"
                android:textSize="10sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
